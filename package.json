{
  "name": "openchamber-droid-connector",
  "version": "0.1.0",
  "description": "OpenCode-API-compatible adapter that lets OpenChamber drive Factory Droid",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openchamber-droid": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx contrib/smoke.ts",
    "v2-smoke": "tsx contrib/v2-smoke.ts",
    "droid-probe": "tsx contrib/droid-probe.ts",
    "permission-smoke": "tsx contrib/permission-smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.31",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@factory/droid-sdk": "^0.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
